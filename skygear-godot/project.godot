; SkyGear Godot port. The original browser project is never referenced at runtime.
; Edit this project only inside skygear-godot/.
config_version=5

[application]

; DO NOT RENAME THIS WITHOUT MIGRATING `user://` IN THE SAME COMMIT (board
; SG-223). It is the alt-tab label, and it is ALSO what Godot derives the save
; directory from: `%APPDATA%/Godot/app_userdata/<sanitised name>`. Changing it
; to "SkyGear" on 2026-08-11 silently pointed the game at a new empty folder —
; `runs.json`, `workshop.json`, `keys.cfg` and `settings.cfg` were all still on
; disk under the old name, and the game simply stopped being able to see them.
; Caught in the same session and reverted. The exe's own identity — the name in
; Explorer, Properties and Task Manager — is fixed where it belongs, in
; `export_presets.cfg`, which has no such coupling.
config/name="SkyGear: Godot Port"
config/description="Keep the Boiler alive through twelve boarding waves."
run/main_scene="res://scenes/main3d.tscn"
; The window and alt-tab icon. `application/icon` in export_presets.cfg points
; at the .ico beside it for the taskbar, the Explorer tile and Properties;
; Windows needs the ICO and Godot needs the PNG. Both are drawn by
; `tools/make_icon.py` from the game's own BRASS/BRASS_LIT/MENU_TEAL constants,
; so the icon tracks the palette instead of drifting from it.
config/icon="res://assets/art/ui/icon.png"
; No Godot logo on launch. The splash was never authored, so it shipped the
; engine's — the first thing a player saw was somebody else's brand.
boot_splash/show_image=false
boot_splash/bg_color=Color(0.051, 0.043, 0.071, 1)

[display]

; 1080p base rather than 720p. With `canvas_items` stretch the 3D scene renders
; at the VIEWPORT size and is then scaled to the window, so a 1280x720 base was
; rendering the deck at 720p and upscaling it on every monitor this will ever
; run on. The HUD layout matrix already asserts the panels fit at 1920x1080.
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
; Fullscreen by default: this is a Windows download now, not a browser tab.
; Borderless rather than exclusive, so alt-tab behaves and a second monitor
; keeps working. F11 toggles, because a game that opens fullscreen with no way
; out is a game people force-quit.
window/size/mode=3
window/stretch/mode="canvas_items"
; DRIFT GUARD, not a distortion fix — Godot already defaults stretch/aspect to
; "keep" and tools/text_audit.gd:95-96 describes the shipped behaviour as a
; letterbox. Pinned explicitly so the editor rewriting this file cannot let the
; default move out from under SG-215's floor-vs-display math (build-72 task 16).
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

[rendering]

; A2. The telegraphs are thin bright rims on a dark deck seen at a grazing
; angle, which is the worst case for aliasing, and an aliased tell is a
; readability problem rather than an ugly one.
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=2
; B2. The dusk sky and the fog gradient are prime banding candidates.
anti_aliasing/quality/use_debanding=true
; Rendered at the full viewport. Left at 1.0 and exposed rather than hidden:
; this is the dial to turn down on a weak machine, and turning it down is a
; better trade than dropping the effects that carry the fight.
scaling_3d/mode=0
scaling_3d/scale=1.0
; The deck is one plane seen edge-on. Sixteen taps is the difference between
; plank detail and mush at the bow.
textures/default_filters/anisotropic_filtering_level=4
; Softer shadow edges at the tightened 34 m distance.
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
window/size/resizable=true

; Windows-first, hardware accelerated. The port started on gl_compatibility
; because that is what a web export wants, and the web export is no longer the
; target: Forward+ is the Vulkan path, and it is the only one that gives 2D
; lighting, real batching and shaders — the things the browser build cannot do
; and the whole reason for being in an engine at all.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.0509804, 0.0431373, 0.0705882, 1)

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
