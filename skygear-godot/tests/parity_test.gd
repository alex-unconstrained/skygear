	await _demo_cut()
	await process_frame
	## AWAITED — it draws SETTINGS and measures two rectangles against each other.
	await _settings_footer_clear()
	await process_frame
	_durable_saves()
	await process_frame
	_dash()
	await process_frame
	await _hazard()
	await process_frame
	await _fire_rates()
	await process_frame
	## AWAITED — both build real worlds and spawn real enemies. See the note
	## above `_view`; an un-awaited coroutine here reports a clean pass for
	## checks that never ran.
	await _wedge()
	await process_frame
	await _seeded_kegs()
	await process_frame
	await _bot()
	await process_frame
	_bal()
